# Insert the limit_req_zone directive in the nginx http block.
limit_req_zone $binary_remote_addr zone=kint_enquiries:10m rate=5r/m;

server {
    listen 80;
    server_name kintconsult.com www.kintconsult.com;
    return 301 https://kintconsult.com$request_uri;
}

server {
    listen 443 ssl;
    server_name www.kintconsult.com;
    ssl_certificate /etc/letsencrypt/live/kintconsult.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kintconsult.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://kintconsult.com$request_uri;
}

server {
    listen 443 ssl;
    server_name kintconsult.com;
    # Certificate must cover both kintconsult.com and www.kintconsult.com.
    ssl_certificate /etc/letsencrypt/live/kintconsult.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kintconsult.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 24k;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;

    location = /api/contact {
        limit_req zone=kint_enquiries burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
