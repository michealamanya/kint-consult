# Public production URL; defaults to the domain supplied in the brief.
NEXT_PUBLIC_SITE_URL=https://kintconsult.com
# Current contact details supplied by KINT; address awaits confirmation.
NEXT_PUBLIC_CONTACT_EMAIL=admin@kintconsult.com
NEXT_PUBLIC_CONTACT_PHONE=0740470116
NEXT_PUBLIC_CONTACT_ADDRESS=
# Server-only HTTPS endpoint accepting POST JSON. Must send 2xx only after
# durably accepting the enquiry. Never expose the token through NEXT_PUBLIC_*.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Required together for live delivery in production. Restrict hostnames in Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Keep production for the existing public host. Build staging with staging.
SITE_ENV=production
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_CONTACT_HOURS=
NEXT_PUBLIC_RESPONSE_TIME=

# Microsoft 365 application credentials: SERVER ONLY. Graph takes priority
# over the webhook when these are complete. Never commit real values.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=admin@kintconsult.com
CONTACT_RECIPIENT=admin@kintconsult.com

# Editorial GitHub repository and external Decap-compatible OAuth endpoint.
# These identify the backend; OAuth client secrets belong on the auth service.
CMS_GITHUB_REPO=michealamanya/kint-consult
CMS_BRANCH=main
CMS_AUTH_URL=

# Optional operator-approved Plausible script URL from its dashboard.
# Disabled by default; restrict to HTTPS and update the privacy notice first.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_DOMAIN=kintconsult.com
